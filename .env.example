# Copy this file to ".env" and paste your own keys after the = sign.
# Never share this file, never upload it, never paste it in chat.

SOCIALCRAWL_API_KEY=your_socialcrawl_api_key_here
FRAMEFETCH_API_KEY=your_framefetch_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Optional settings (the defaults are fine to start) ---
GEMINI_MODEL=gemini-2.5-flash
MAX_REELS=20            # how many reels to read per run (keeps cost low)
SEARCH_PHRASES=6        # how many search phrases the AI makes from your topic
SC_MAX_CREDITS=15       # most SocialCrawl credits one run may spend on searching
DATE_WINDOW=last-month  # last-week | last-month | last-year
MIN_VIEWS=1000          # ignore reels with fewer views than this
FRAMES_PER_SECOND=0.5   # screenshot rate sent to FrameFetch
MAX_FRAMES_TO_AI=8      # screenshots shown to the AI per reel
SHOW_HANDLES=false      # keep false so reports do not name private creators

# Used to tailor the video ideas
GOAL=grow views and build trust as a dog health channel
ON_CAMERA=voiceover on dog footage
AUDIENCE=English-speaking dog owners
